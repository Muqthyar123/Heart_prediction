# HeartPredict AI Flask Backend Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-key-in-production
JWT_SECRET_KEY=change-this-jwt-key-to-a-secure-random-key

# Database: Default SQLite for development, PostgreSQL in production
DATABASE_URL=sqlite:///heartpredict.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/heartpredict_db

# CORS Configuration: Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# JWT Lifetimes (in minutes / days)
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=16
MAX_BULK_ROWS=5000
SYNCHRONOUS_BULK_LIMIT=500

# Artifacts directory path (relative to backend or absolute)
ARTIFACTS_DIR=artifacts
